# Shared local cluster configuration.
# Override any value by exporting it before running scripts/up.sh.

# Host ports. Change one only if something else on the machine already owns it.
REDIS_PORT=6379
POSTGRES_PORT=5432
UNLEASH_PORT=4242
REDISINSIGHT_PORT=8001
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
# Host port only. Containers always reach the registry at schema-registry:8081,
# which the repo bootstrap scripts hardcode, so remapping here is safe.
# Moved off 8081 because that port is commonly taken by other local services.
SCHEMA_REGISTRY_PORT=8085
REST_PROXY_PORT=8082
CONNECT_PORT=8083
KAFKA_UI_PORT=8090
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
JAEGER_UI_PORT=16686

# Topics created at startup, as name:partitions:replicas separated by commas.
# Adding a topic here is the only change needed for a new consumer; init-kafka
# applies the list with --if-not-exists on every `up`.
#
#   ai-gateway-logs                  ms-ml-ai-gateway-bs audit events
#   data.payments.transaction.filter ms-ml-ai-gateway-bs bootstrap fixture (+ dlq)
#   data.events.ai.assistant.*       ms-ml-genai-agents-bs
#   (none for conversation_events)   its Debezium connector creates yape.event_store.conversation_events itself, with 3 partitions
#                                    (topic.creation.default.partitions in ms-ml-conv-history-publisher), so it is not listed here
KAFKA_CREATE_TOPICS=ai-gateway-logs:1:1,data.payments.transaction.filter:1:1,data.payments.transaction.filter-dlq:1:1,data.events.ai.assistant.promptguard.events:1:1,data.events.ai.assistant.conversation.session.event:1:1,data.events.ai.assistant.fsm.event:1:1,data.events.ai.assistant.payment.p2p:1:1
