# Unleash server configuration for the shared local cluster.
#
# docker compose env_file expects KEY=value. The per-repo copies of this file
# use "KEY: value" (YAML style), which compose does not parse, so those settings
# never reached the container.
DATABASE_URL=postgres://postgres:postgres@db/postgres
DATABASE_SSL=false
LOG_LEVEL=warn
INIT_FRONTEND_API_TOKENS=default:development.unleash-insecure-frontend-api-token
INIT_CLIENT_API_TOKENS=default:development.unleash-insecure-api-token
